          "body": "<style>\n:root{--paper:#F3EEE4;--paper-2:#EAE2D2;--ink:#20191A;--brick:#B23A26;--brick-deep:#7E2517;--muted:#6A605A;--line:rgba(32,25,26,.14)}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml{}\nbody{background:var(--paper);color:var(--ink);font-family:\"Songti SC\",\"STSong\",\"SimSun\",Georgia,\"Times New Roman\",serif;line-height:1.7;-webkit-font-smoothing:antialiased;padding-bottom:5rem}\na{color:inherit;text-decoration:none}\n.wrap{max-width:1080px;margin:0 auto;padding:0 clamp(1.2rem,4vw,3rem)}\n\n/* ---------- HERO (poster) ---------- */\n.hero{position:relative;background:var(--paper);border-bottom:2px solid var(--ink);overflow:hidden}\n.hero .wrap{padding-top:clamp(3rem,9vw,6rem);padding-bottom:clamp(4rem,12vw,8rem)}\n.kicker{font-size:.82rem;letter-spacing:.42em;color:var(--brick);text-transform:uppercase;font-weight:700}\n.wordmark{font-family:\"Arial Black\",\"Helvetica Neue\",Impact,sans-serif;font-weight:900;font-size:clamp(5.5rem,26vw,20rem);line-height:.82;letter-spacing:-.02em;margin:.1em 0 .12em;word-break:break-all}\n.wordmark em{font-style:normal;color:var(--brick)}\n.hero-sub{max-width:34ch;font-size:clamp(1.05rem,2.4vw,1.4rem);color:var(--ink);border-left:3px solid var(--brick);padding-left:1rem;margin-top:.4rem}\n.hero-note{margin-top:1.6rem;color:var(--muted);font-size:.95rem;max-width:52ch}\n.stamp{position:absolute;top:clamp(1.2rem,4vw,2.4rem);right:clamp(1.2rem,4vw,2.4rem);width:5.2rem;height:5.2rem;border:2px dashed var(--brick);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--brick);font-size:.62rem;letter-spacing:.12em;text-align:center;line-height:1.3;transform:rotate(-12deg)}\n.stamp b{font-size:1.1rem;letter-spacing:0}\n\n/* ---------- SECTION SHELL ---------- */\nsection{padding:clamp(3.2rem,8vw,6rem) 0;border-bottom:1px solid var(--line)}\n.sec-head{display:flex;gap:1.2rem;align-items:baseline;margin-bottom:2.2rem}\n.sec-num{font-family:\"Arial Black\",s