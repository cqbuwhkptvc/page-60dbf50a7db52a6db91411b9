-items:start}}\n.plan.feat{background:var(--paper-2);border-color:var(--brick)}\n.plan-tag{display:inline-block;font-size:.7rem;letter-spacing:.16em;color:#fff;background:var(--brick);padding:.15rem .6rem;margin-bottom:.6rem;font-weight:700}\n.plan-name{font-size:1.5rem;font-weight:700}\n.plan-price{font-family:\"Arial Black\",sans-serif;font-size:2.4rem;color:var(--brick);line-height:1;margin-top:.4rem}\n.plan-price small{font-family:inherit;font-size:.9rem;color:var(--ink);font-weight:400}\n.plan-annual{color:var(--muted);font-size:.9rem;margin-top:.3rem}\n.feat-list{list-style:none;display:flex;flex-wrap:wrap;gap:.5rem}\n.feat-list li{border:1px solid var(--line);padding:.4rem .8rem;font-size:.92rem;background:var(--paper)}\n.plan.feat .feat-list li{background:var(--paper)}\n.plans-note{margin-top:1.4rem;color:var(--muted);font-size:.9rem;border-top:1px dashed var(--line);padding-top:1rem}\n\n/* ---------- GUIDE (steps) ---------- */\n.steps{counter-reset:s;display:grid;gap:1.4rem}\n.step{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;align-items:start}\n.step::before{counter-increment:s;content:counter(s,decimal-leading-zero);font-family:\"Arial Black\",sans-serif;font-size:1.6rem;color:var(--brick);border:2px solid var(--brick);width:3rem;height:3rem;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:1.15rem;margin-bottom:.2rem}\n.step p{color:var(--muted);font-size:.98rem}\n\n/* ---------- FAQ (numbered) ---------- */\n.faq{display:grid;gap:0;border-top:1px solid var(--line)}\n.qa{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;padding:1.4rem 0;border-bottom:1px solid var(--line)}\n.qa .n{font-family:\"Arial Black\",sans-serif;color:var(--brick);font-size:1.1rem}\n.qa h3{font-size:1.15rem;margin-bottom:.4rem}\n.qa p{color:var(--muted)}\n\n/* ---------- FOOTER ---------- */\nfooter{padding:clamp(2.6rem,6vw,4rem) 0 2rem}\n.foot-mark{font-family:\"Arial Black\",sans-serif;font-size:clamp(2.6rem,10vw,5rem);letter-spacing:-.02em;line-height:1}\n.foot-mark span{color:var(--brick)}\n.foot-line{color:var(--muted);font-size:.9rem;margin-top:1rem;max-width:60ch}\n\n/* ---------- FIXED TEXT NAV ---------- */\n.nav{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--ink);color:var(--paper);display:flex;gap:1.4rem;justify-content:center;flex-wrap:wrap;padding:.85rem 1rem;font-size:.82rem;letter-spacing:.14em}\n.nav a{opacity:.85;transition:opacity .2s,color .2s}\n.nav a:hover{opacity:1;color:var(--brick)}\n.nav a::before{content:\"— \";color:var(--brick)}\n@media(max-width:520px){.nav{gap:.9rem;font-size:.72rem;letter-spacing:.08em}}\n</style><main>\n\n  \n  <header class=\"hero\" id=\"top\">\n    <div class=\"stamp\"><b>B·K</b><span>网络通行<br>私人笔记</span></div>\n    <div class=\"wrap\">\n      <p class=\"kicker\">Field Notes · Network Passage</p>\n      <h1 class=\"wordmark\">BL<em>A</em>CK</h1>\n      <p class=\"hero-sub\">不谈玄学，只谈一件具体的事——让数据从你的设备，稳稳地抵达它该去的地方。</p>\n      <p class=\"hero-note\">这是一份写给普通用户的通行说明。没有夸张的承诺，只有可以核对的方案、步骤与问题清单。往下读，你会知道 BLACK 到底在做什么，以及它适不适合你。</p>\n    </div>\n  </header>\n\n  \n  <section id=\"why\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01</span>\n        <div>\n          <h2 class=\"sec-title\">为什么是「通行」，而不是「加速」</h2>\n          <p class=\"sec-kick\">立场先说清楚</p>\n        </div>\n      </div>\n      <div class=\"grid-2\">\n        <p class=\"lede dropcap\">市面上太多产品喜欢用速度当卖点，仿佛只要数字够大，一切就顺理成章。但真正影响体验的，往往是稳定、可达与可控这三件不那么性感的事。BLACK 选择把自己定位成一种「通行」工具：我们关心的是连接能否建立、能否维持、出了问题有没有人接得住，而不是一句谁也无法验证的口号。</p>\n        <blockquote class=\"pull\">\n          好的基础设施像水电，你不会天天夸它快，只会在它断掉的那一刻才想起它的存在。\n          — BLACK 编辑部\n        </blockquote>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"what\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02</span>\n        <div>\n          <h2 class=\"sec-title\">它具体解决什么</h2>\n          <p class=\"sec-kick\">四件事，逐条对应</p>\n        </div>\n      </div>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <span class=\"idx\">01</span>\n          <h3>稳定的连接</h3>\n          <p>与其追求峰值，不如保证长时间不掉线。线路质量优先于瞬时速度，适合需要连续使用的场景。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"idx\">02</span>\n          <h3>多设备同时在线</h3>\n          <p>手机、电脑、平板共用一个账户，按套餐分配并发数量，家庭或小团队都能各取所需。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"idx\">03</span>\n          <h3>内容可达性</h3>\n          <p>面向常见的流媒体与网页访问做适配，让原本打不开的内容重新变得可打开，而非承诺万能。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"idx\">04</span>\n          <h3>有人兜底的支持</h3>\n          <p>出问题时有工单可提、有渠道可问。高级别方案配备优先响应与专属对接，减少等待成本。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03</span>\n        <div>\n          <h2 class=\"sec-title\">三种通行方式</h2>\n          <p class=\"sec-kick\">按月或按年，逐行看权益</p>\n        </div>\n      </div>\n\n      <div class=\"plan\">\n        <div>\n          <h3 class=\"plan-name\">基础版</h3>\n          <div class=\"plan-price\">¥15<small>/月</small></div>\n          <p class=\"plan-annual\">按年付仅需 ¥150/年</p>\n        </div>\n        <ul class=\"feat-list\">\n          <li>每月 100GB 流量额度</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </div>\n\n      <div class=\"plan feat\">\n        <div>\n          <span class=\"plan-tag\">推荐</span>\n          <h3 class=\"plan-name\">旗舰版</h3>\n          <div class=\"plan-price\">¥35<small>/月</small></div>\n          <p class=\"plan-annual\">按年付仅需 ¥350/年</p>\n        </div>\n        <ul class=\"feat-list\">\n          <li>每月 300GB 流量额度</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </div>\n\n      <div class=\"plan\">\n        <div>\n          <h3 class=\"plan-name\">团队版</h3>\n          <div class=\"plan-price\">¥85<small>/月</small></div>\n          <p class=\"plan-annual\">按年付仅需 ¥850/年</p>\n        </div>\n        <ul class=\"feat-list\">\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </div>\n\n      <p class=\"plans-note\">价格与流量额度以上述标注为准；升级或降级可在计费周期内申请，具体生效时间以账户后台提示为据。此处不展示任何未经核实的折扣或限时活动。</p>\n    </div>\n  </section>\n\n  \n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">04</span>\n        <div>\n          <h2 class=\"sec-title\">第一次使用怎么走完</h2>\n          <p class=\"sec-kick\">五步，从零到可用</p>\n        </div>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div>\n            <h3>选定方案</h3>\n            <p>先估算自己一个月大概用多少流量、几台设备会同时连。拿不准就从基础版开始，够用再升。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>创建账户</h3>\n            <p>注册后系统会生成属于你的接入配置。把它当作一把钥匙，不要随意公开给他人。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>导入设备</h3>\n            <p>在手机、电脑或平板上填入配置并保存。并发数受套餐限制，超出时请先断开一台。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>测试连通</h3>\n            <p>打开任意目标页面确认能正常加载。若某类内容仍打不开，记录现象便于后续反馈。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div>\n            <h3>按需调整</h3>\n            <p>观察一周的真实用量后再决定是否需要更高额度或更多并发，避免长期闲置浪费。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">05</span>\n        <div>\n          <h2 class=\"sec-title\">你可能会问的问题</h2>\n          <p class=\"sec-kick\">按编号逐条回答</p>\n        </div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"qa\">\n          <span class=\"n\">Q1</span>\n          <div>\n            <h3>流量用完会怎样？</h3>\n            <p>达到当月额度后，新周期开始前通常无法继续消耗。你可以等待下月重置，或在后台查看是否支持临时补充，具体以账户提示为准。</p>\n          </div>\n        </div>\n        <div class=\"qa\">\n          <span class=\"n\">Q2</span>\n          <div>\n            <h3>能同时在几台设备上用？</h3>\n            <p>取决于套餐：基础版 3 台、旗舰版 5 台、团队版 20 台。这里的数字指「同时在线」的数量，不是累计登录过的设备总数。</p>\n          </div>\n        </div>\n        <div class=\"qa\">\n          <span class=\"n\">Q3</span>\n          <div>\n            <h3>月付和年付的区别是什么？</h3>\n            <p>功能权益相同，差别在于支付节奏与总价。年付一次性覆盖十二个月，折算下来单价更低，适合已经确定要长期使用的人。</p>\n          </div>\n        </div>\n        <div class=\"qa\">\n          <span class=\"n\">Q4</span>\n          <div>\n            <h3>什么是 IPLC 专线？</h3>\n          <p>它是旗舰版列出的一项线路类型，常用于对延迟敏感的场景。本页仅如实转述方案中的描述，不对具体数值表现作额外承诺。</p>\n          </div>\n        </div>\n        <div class=\"qa\">\n          <span class=\"n\">Q5</span>\n          <div>\n            <h3>遇到问题怎么找人工？</h3>\n            <p>所有方案都可通过工单提交问题；旗舰版享有 7×24 优先响应，团队版另有专属客户经理对接。提交时附上设备与现象描述会更快定位。</p>\n          </div>\n        </div>\n        <div class=\"qa\">\n          <span class=\"n\">Q6</span>\n          <div>\n            <h3>可以随时升级或降级吗？</h3>\n            <p>可以在计费周期内发起变更，生效时间与差价处理以账户后台显示为准。建议先用满当前周期的真实数据，再做决定。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer id=\"about\">\n    <div class=\"wrap\">\n      <div class=\"foot-mark\">BL<span>A</span>CK</div>\n      <p class=\"foot-line\">一份克制的网络通行说明。我们不承诺奇迹，只把能核对的事情写清楚。请遵守所在地区的相关法律法规，将本服务用于合法用途。</p>\n    </div>\n  </footer>\n\n</main>\n\n<nav class=\"nav\">\n  <a href=\"#top\">回到顶部</a>\n  <a href=\"#what\">它能做什么</a>\n  <a href=\"#plans\">通行方案</a>\n  <a href=\"#guide\">上手步骤</a>\n  <a href=\"#faq\">常见问题</a>\n</nav>",
